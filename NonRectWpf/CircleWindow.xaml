<Window x:Class="NonRectWpf.CircleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circle"
        Width="300" Height="300"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid MouseLeftButtonDown="DragWindow">
        <Ellipse Width="280" Height="280" Fill="#2196F3">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3"/>
            </Ellipse.Effect>
        </Ellipse>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Круглое окно" Foreground="White" FontSize="20"
                       HorizontalAlignment="Center"/>
            <Button Content="Закрыть" Margin="0,15,0,0" Padding="20,5"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
