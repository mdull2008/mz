<Window x:Class="ContextMenuWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Menu WPF"
        Width="500" Height="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Text="ПКМ по элементам ниже"
                   FontSize="14" Margin="0,0,0,15"/>

        <ListBox x:Name="ItemsList" Grid.Row="1" SelectionChanged="ItemsList_SelectionChanged">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить" Click="AddItem_Click"/>
                    <MenuItem Header="Удалить" Click="DeleteItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Очистить всё" Click="ClearAll_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBoxItem Content="Элемент 1"/>
            <ListBoxItem Content="Элемент 2"/>
            <ListBoxItem Content="Элемент 3"/>
        </ListBox>

        <Border x:Name="ColorPanel" Grid.Row="2" Margin="0,15,0,0" Padding="15"
                Background="#E3F2FD" CornerRadius="8">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Синий фон" Click="BlueBg_Click"/>
                    <MenuItem Header="Зелёный фон" Click="GreenBg_Click"/>
                    <MenuItem Header="Сбросить" Click="ResetBg_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <TextBlock Text="ПКМ здесь — сменить цвет фона" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
